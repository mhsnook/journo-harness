{
  "$schema": "./node_modules/oxfmt/configuration_schema.json",
  "semi": false,
  "singleQuote": true,
  "useTabs": false,
  "tabWidth": 2,
  "printWidth": 90,
  "sortImports": true,
  "sortTailwindcss": {
    "functions": ["cx"],
    "stylesheet": "./src/client/styles/theme.css"
  },
  // .agents holds the same vendored skills as .claude, pinned by
  // skills-lock.json. Reformatting either one produces a diff against the
  // package that comes back on the next skill update.
  "ignorePatterns": [".claude/**", ".agents/**", "src/client/routeTree.gen.ts"],
  "overrides": [
    {
      "files": ["**/*.{js,mjs,cjs,jsx,ts,mts,cts,tsx,css,html}"],
      "options": { "useTabs": true }
    }
  ]
}
