{
  "name": "journo-harness",
  "version": "0.1.0",
  "private": true,
  "description": "A writing harness where the writer writes the prose and an AI acts as a guide.",
  "type": "module",
  "scripts": {
    "preinstall": "npx only-allow pnpm",
    "postinstall": "wrangler types",
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "deploy": "vite build && wrangler deploy",
    "db:migrate": "wrangler d1 migrations apply journo-harness --local",
    "db:migrate:remote": "wrangler d1 migrations apply journo-harness --remote",
    "test": "vite build && vitest run",
    "test:shared": "vitest run --project shared",
    "test:client": "vitest run --project client",
    "test:stories": "vitest run --project stories",
    "test:watch": "vitest",
    "typecheck": "wrangler types --check && tsc --build",
    "lint": "oxlint .",
    "format": "oxfmt .",
    "format:check": "oxfmt --check .",
    "storybook": "storybook dev -p 6006",
    "build-storybook": "storybook build"
  },
  "dependencies": {
    "@cloudflare/ai-chat": "^0.10.1",
    "@tanstack/react-query": "^5.101.4",
    "@tanstack/react-router": "^1.170.20",
    "agents": "^0.20.1",
    "ai": "^7.0.55",
    "hono": "^4.13.0",
    "lucide-react": "^1.30.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "workers-ai-provider": "^4.0.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "^1.51.0",
    "@cloudflare/vitest-pool-workers": "^0.20.2",
    "@storybook/addon-a11y": "^10.5.7",
    "@storybook/addon-docs": "^10.5.7",
    "@storybook/addon-vitest": "^10.5.7",
    "@storybook/react-vite": "^10.5.7",
    "@tailwindcss/vite": "^4.3.3",
    "@tanstack/router-plugin": "^1.168.25",
    "@types/node": "^26.1.2",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@vitejs/plugin-react": "^6.0.5",
    "@vitest/browser": "^4.1.10",
    "@vitest/browser-playwright": "^4.1.10",
    "oxfmt": "^0.62.0",
    "oxlint": "^1.77.0",
    "playwright": "^1.62.1",
    "storybook": "^10.5.7",
    "tailwindcss": "^4.3.3",
    "typescript": "^5.9.3",
    "vite": "^8.2.0",
    "vitest": "^4.1.10",
    "wrangler": "^4.119.0"
  },
  "packageManager": "pnpm@11.1.2"
}
