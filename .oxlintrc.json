{
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  "plugins": ["typescript", "unicorn", "oxc", "react", "import", "vitest"],
  "categories": {
    "correctness": "error"
  },
  "rules": {},
  "env": {
    "builtin": true,
    "browser": true,
    "es2024": true
  },
  // Skills under .claude and .agents are vendored packages pinned by
  // skills-lock.json. Linting them reports on code this repo does not own, and
  // the findings would come back on the next skill update anyway.
  "ignorePatterns": [
    "src/client/routeTree.gen.ts",
    "worker-configuration.d.ts",
    ".claude/**",
    ".agents/**"
  ],
  "overrides": [
    {
      "files": [
        "src/server/**",
        "test/**",
        "*.config.ts",
        ".storybook/**",
        ".github/ci/**"
      ],
      "env": { "browser": false, "node": true }
    },
    {
      // `this.sql` is a statement written as a tagged template, so a write
      // discards the rows it returns. Only the Agents SDK spells it that way.
      "files": ["src/server/**"],
      "rules": { "no-unused-expressions": ["error", { "allowTaggedTemplates": true }] }
    }
  ]
}
